# =============================================================================
# ThermoProActive — variáveis de PRODUÇÃO
# Copie para .env.prod e preencha.  NUNCA versione o .env.prod (contém segredos).
#   cp .env.prod.example .env.prod   &&   nano .env.prod
# Uso:  docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# =============================================================================

# --- Domínio (sem http, sem barra) -------------------------------------------
# Ex.: thermoproactive.com.br   (o Nginx e o certificado usam este valor)
DOMAIN=seudominio.com.br

# E-mail para o Let's Encrypt avisar sobre expiração do certificado.
# Use um e-mail da CONTRATANTE (titular do ambiente) — Cláusula 12.
CERTBOT_EMAIL=responsavel@seudominio.com.br

# --- Django ------------------------------------------------------------------
# Em produção SEMPRE False (o compose também assume False se a linha faltar).
DEBUG=False
# S-26: o /django-admin/ fica DESLIGADO em produção por padrão (segue DEBUG).
# Para usar, defina True explicitamente e restrinja por IP/VPN no nginx.
# DJANGO_ADMIN_ENABLED=False
# Gere uma chave forte (o servidor RECUSA subir em produção com chave curta/fraca):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=TROQUE-POR-UMA-CHAVE-ALEATORIA-LONGA

# ATENÇÃO: a SECRET_KEY também deriva a chave que cifra os segredos de MFA (TOTP) e os
# hashes de IP do log de segurança. Perdê-la ou trocá-la invalida sessões e obriga todos
# os usuários com MFA a recadastrar. Guarde uma cópia deste .env.prod no cofre de senhas
# da CONTRATANTE (o backup automático cobre banco e arquivos, NÃO este arquivo).
# Para desacoplar: defina MFA_ENCRYPTION_KEY (chave própria do MFA) ANTES de ter usuários
# com MFA — trocar depois exige recadastro:
# MFA_ENCRYPTION_KEY=

# Hosts que o Django aceita. Inclua o domínio, www e o nome do serviço interno.
ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br,backend

# Origens confiáveis para CSRF (precisa do https:// — usado pelo /admin).
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# Cookies de sessão só com HTTPS. Deixe comentado (padrão = True) sempre que
# houver TLS. Descomente APENAS em deploy HTTP puro — ex.: VPS acessada por IP,
# onde o Let's Encrypt não emite certificado. Com False o cookie de sessão
# trafega em claro e pode ser capturado na rede: use só em teste/homologação.
# COOKIES_SECURE=False

# Como front e API ficam no MESMO domínio, o CORS é trivial (mesma origem).
CORS_ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br
FRONTEND_URL=https://seudominio.com.br

# --- Banco PostgreSQL --------------------------------------------------------
# Troque a senha. Os três valores abaixo DEVEM bater com o DATABASE_URL.
POSTGRES_DB=thermoproactive
POSTGRES_USER=thermo
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
DATABASE_URL=postgres://thermo:TROQUE-POR-UMA-SENHA-FORTE@db:5432/thermoproactive

# --- Frontend ----------------------------------------------------------------
# EMBUTIDO NO BUNDLE EM BUILD-TIME. O navegador chama a API neste endereço.
# Como usamos domínio único, aponte para /api do próprio domínio.
NEXT_PUBLIC_API_URL=https://seudominio.com.br/api

# --- E-mail (opcional — notificações 2.10) -----------------------------------
# Sem isto, e-mails apenas aparecem no log (console). Para envio real, use SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.seuprovedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario
# EMAIL_HOST_PASSWORD=senha
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ThermoProActive <nao-responda@seudominio.com.br>

# Canais externos opcionais (mantêm-se desligados — sem lock-in, Cláusula 12.4).
NOTIFICACOES_WHATSAPP_ENABLED=False
NOTIFICACOES_PUSH_ENABLED=False

# --- Backup automático (serviço `backup` — ver docs/19-OPERACAO-DEPLOY-BACKUP.md) ---
# Pasta NO HOST onde ficam os backups criptografados (fora dos volumes Docker, para
# que 'docker compose down -v' não os apague). Precisa de espaço p/ ~14 cópias.
BACKUP_HOST_DIR=/var/backups/thermoproactive
# Pasta NO HOST, fora do repositório, com os segredos do backup (chmod 700):
#   backup.passphrase  -> frase-secreta da criptografia (>= 16 caracteres, 1 linha)
#   rclone.conf        -> (opcional) credenciais do destino externo
# SEM a frase-secreta NÃO existe restauração: guarde uma cópia FORA da VPS (cofre
# de senhas da contratante). Nunca versione estes arquivos.
BACKUP_CONFIG_DIR=/root/.thermoproactive
BACKUP_TZ=America/Sao_Paulo
BACKUP_AT=03:15
# Retenção local: últimos N diários, semanais (domingo) e mensais (dia 1).
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# Destino EXTERNO (recomendado; sem ele os backups moram no mesmo servidor).
# Qualquer destino suportado pelo rclone (S3-compatível, SFTP, B2, WebDAV, Drive...).
# As credenciais são da CONTRATANTE — configure em ${BACKUP_CONFIG_DIR}/rclone.conf
# (rclone config) e informe aqui "<remoto>:<bucket-ou-pasta>/thermoproactive".
# BACKUP_RCLONE_REMOTE=meuremoto:bucket/thermoproactive
# BACKUP_REMOTE_RETENTION_DAYS=400
# Aviso de falha (opcional): URL que receba um POST JSON {"text": "..."}
# (Slack/Discord/Mattermost/n8n/ntfy...). Vazio = só log e healthcheck.
# BACKUP_ALERT_WEBHOOK=
