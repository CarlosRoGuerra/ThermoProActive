# =============================================================================
# ThermoProActive — variáveis de PRODUÇÃO
# Copie para .env.prod e preencha.  NUNCA versione o .env.prod (contém segredos).
#   cp .env.prod.example .env.prod   &&   nano .env.prod
# Uso:  docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# =============================================================================

# --- Domínio (sem http, sem barra) -------------------------------------------
# Ex.: thermoproactive.com.br   (o Nginx e o certificado usam este valor)
DOMAIN=seudominio.com.br

# E-mail para o Let's Encrypt avisar sobre expiração do certificado.
CERTBOT_EMAIL=contato.guerrait@gmail.com

# --- Django ------------------------------------------------------------------
DEBUG=False
# Gere uma chave forte:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=TROQUE-POR-UMA-CHAVE-ALEATORIA-LONGA

# Hosts que o Django aceita. Inclua o domínio, www e o nome do serviço interno.
ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br,backend

# Origens confiáveis para CSRF (precisa do https:// — usado pelo /admin).
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# Como front e API ficam no MESMO domínio, o CORS é trivial (mesma origem).
CORS_ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# --- Banco PostgreSQL --------------------------------------------------------
# Troque a senha. Os três valores abaixo DEVEM bater com o DATABASE_URL.
POSTGRES_DB=thermoproactive
POSTGRES_USER=thermo
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
DATABASE_URL=postgres://thermo:TROQUE-POR-UMA-SENHA-FORTE@db:5432/thermoproactive

# --- Frontend ----------------------------------------------------------------
# EMBUTIDO NO BUNDLE EM BUILD-TIME. O navegador chama a API neste endereço.
# Como usamos domínio único, aponte para /api do próprio domínio.
NEXT_PUBLIC_API_URL=https://seudominio.com.br/api

# --- E-mail (opcional — notificações 2.10) -----------------------------------
# Sem isto, e-mails apenas aparecem no log (console). Para envio real, use SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.seuprovedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario
# EMAIL_HOST_PASSWORD=senha
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ThermoProActive <nao-responda@seudominio.com.br>

# Canais externos opcionais (mantêm-se desligados — sem lock-in, Cláusula 12.4).
NOTIFICACOES_WHATSAPP_ENABLED=False
NOTIFICACOES_PUSH_ENABLED=False
