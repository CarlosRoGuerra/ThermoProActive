# Copie para backend/.env e ajuste. Sem .env o sistema roda com SQLite (dev).
SECRET_KEY=troque-por-uma-chave-aleatoria-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (produção). Comente para usar SQLite em dev.
# DATABASE_URL=postgres://thermo:thermo@localhost:5432/thermoproactive

# Origens permitidas para o frontend (Next.js)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Notificações (Anexo I 2.10) ---
# Dev: console (imprime e-mails no log). Produção: SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.seuprovedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario
# EMAIL_HOST_PASSWORD=senha
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=ThermoProActive <nao-responda@seudominio.com>
# Canais externos opcionais (adaptadores plugáveis, sem fornecedor obrigatório):
NOTIFICACOES_WHATSAPP_ENABLED=False
NOTIFICACOES_PUSH_ENABLED=False
